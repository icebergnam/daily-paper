{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR}/.claude/hooks/매일논문_루프.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR}/.claude/hooks/매일논문_루프.py\""
          }
        ]
      }
    ]
  }
}
